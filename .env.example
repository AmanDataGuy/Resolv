# --- LLM provider selection (config.py) ---------------------------------------
# The harness is provider-agnostic. Whichever provider's key is set is used; if both
# are present, OpenRouter wins unless you override with LLM_PROVIDER. On a rate limit
# mid-run, agents/runner_utils.py rotates to the next _2/_3 key and retries (config.rotate_key()).
# Gemini is opt-in ONLY (LLM_PROVIDER=gemini) — a key present here is never spent without that
# explicit choice, since it's the one pay-as-you-go provider with no free tier ceiling.
#
#   LLM_PROVIDER   groq | openrouter | gemini    (optional; auto-detected from which key is set)
#   LLM_MODEL      override the default model, e.g.:
#                  openrouter/nvidia/nemotron-3-super-120b-a12b:free   (verified free, tool-calling)
#                  openrouter/meta-llama/llama-3.3-70b-instruct        (paid; needs OpenRouter credit)
#                  groq/llama-3.3-70b-versatile
LLM_PROVIDER=
LLM_MODEL=

GEMINI_API_KEY=

# Groq: free tier is 12k tokens/min AND 100k tokens/DAY per org — fine for small runs,
# too small for a full pass^k sweep (millions of tokens).
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# OpenRouter: one API over many providers. FREE (:free) models are capped at ~50 req/DAY
# per ACCOUNT (three keys on one account share it) and use congested upstream endpoints.
# ~$10 of credit lifts this to 1000 req/day AND unlocks reliable paid model endpoints.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# --- Online eval / observability (OPTIONAL) ----------------------------------
# Langfuse traces every /resolve request (latency, cost, safety scores). Leave blank to disable —
# eval/monitor.py still records local telemetry to data/telemetry/live.jsonl either way. Get keys
# from a free langfuse.com project; set LANGFUSE_HOST only for self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Policy thresholds (config.py) — optional, defaults shown ------------------
# Env-overridable per deployment. Neither the agent nor the extractor can see or change these;
# they're read once by harness/policy.py and are the entire "money" surface of the system.
AUTO_APPROVE_MAX_USD=200.0
CLAIM_WINDOW_DAYS=90
