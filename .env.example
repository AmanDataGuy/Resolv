# --- Environment ----------------------------------------------------------------
# dev | test | eval | prod. prod requires AUTH_SECRET and ORDER_PROOF_SECRET (fail closed) and masks PII
# before customer text reaches the LLM.
RESOLV_ENV=dev

# --- LLM provider (resolv/config.py) ------------------------------------------------------
# One key per provider. If you hit a free tier's daily cap, wait, use a paid tier, or self-host
# (see docs/inference.md). Gemini is opt-in only (LLM_PROVIDER=gemini): a key here is never spent
# without that explicit choice.
#
#   LLM_PROVIDER   groq | openrouter | gemini | selfhosted   (optional; auto-detected from which key is set)
#   LLM_MODEL      default model for every role, e.g. groq/openai/gpt-oss-120b
LLM_PROVIDER=
LLM_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Per-role models (each overrides only its own role; blank = LLM_MODEL / provider default).
# "selfhosted:<name>" is shorthand for hosted_vllm/<name> at SELFHOSTED_BASE_URL.
AGENT_MODEL=
EXTRACTOR_MODEL=
SIMULATOR_MODEL=
JUDGE_MODEL=
# json | legacy_line (legacy_line = the GRPO adapter's one-line format)
EXTRACTOR_BACKEND=json

# Self-hosted OpenAI-compatible server (vLLM / llama.cpp). Port 8000 is the Resolv API.
SELFHOSTED_BASE_URL=http://localhost:8001/v1
SELFHOSTED_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SELFHOSTED_API_KEY=

# --- Observability (optional) -------------------------------------------------------
# Langfuse (SDK 4.x) receives nested OTel spans and scores. Blank = tracing off, no network.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# 1 = put PII-masked message content on spans. Off by default.
RESOLV_TRACE_CONTENT=0
# 1 = trace eval sweeps too (off by default).
RESOLV_TRACE_EVAL=0
# Release tag on traces.
GIT_SHA=

# --- Policy thresholds (resolv/config.py), defaults shown ---------------------------------
AUTO_APPROVE_MAX_USD=200.0
CLAIM_WINDOW_DAYS=90

# --- Identity (resolv/api/auth.py) ---------------------------------------------------------
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Unset in dev/test = a random per-process key (tokens die on restart). Required in prod.
AUTH_SECRET=
ORDER_PROOF_SECRET=
# Header your platform proxy sets with the real client IP (e.g. Fly-Client-IP). Blank = socket peer.
TRUSTED_CLIENT_IP_HEADER=

# --- Ledger, audit chain, payments (resolv/harness/ledger.py, resolv/integrations/payments.py) -------
RESOLV_DB=data/resolv.db
RESOLV_PSP_DB=data/psp.db
# HMAC key for the audit hash chain. Required in prod; dev/test use a fallback.
AUDIT_HMAC_KEY=
AUDIT_KEY_ID=k1
# Retired keys still accepted when verifying, as id:key,id:key
AUDIT_OLD_KEYS=
# 1 = journal each step so a crashed case resumes (default on, off in test/eval).
RESOLV_DURABLE=

# --- Operator switches (resolv/harness/tools.py, docs/RUNBOOK.md) -------------------------
# 1 = kill switch: every refund policy would allow is escalated to a person instead. Nothing is paid.
REFUNDS_FROZEN=0
# 1 = shadow mode: the agent and policy run, allowed refunds are recorded as "would have", no money moves.
# Refused when RESOLV_ENV is test or eval.
RESOLV_SHADOW=0

# --- Agent behaviour ------------------------------------------------------------------
# 1 = mask PII in customer text before it reaches the model (default on in prod).
REDACT_BEFORE_LLM=
# 1 = lookup_order also shows the max refundable amount (one-variable A/B arm).
SHOW_MAX_REFUNDABLE=0
# low | medium | high for gpt-oss models; blank = provider default.
REASONING_EFFORT=

# --- Load tests (loadtest/README.md) --------------------------------------------------
# 1 = canned model replies, no provider calls. Never in prod.
RESOLV_FAKE_LLM=0
FAKE_LLM_LATENCY_S=0

# --- Evals and monitoring -------------------------------------------------------------
# exact = a refund-owed task must pay the cap exactly; ceiling = any amount up to the cap passes.
RESOLV_ENTITLEMENT=exact
# Hard USD cap for scheduled sweeps.
NIGHTLY_USD_CAP=0.50
# Where live telemetry rows go (blank = data/telemetry/live.jsonl).
RESOLV_TELEMETRY=
# POST target for the unauthorized-refund alert; blank = log only.
RESOLV_ALERT_WEBHOOK=
