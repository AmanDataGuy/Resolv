# --- Phase 0/1: local, no GCP required ---
GEMINI_API_KEY=

# --- LLM provider selection (config.py) ---------------------------------------
# The harness is provider-agnostic. Whichever provider's key is set is used; if both
# are present, OpenRouter wins unless you override with LLM_PROVIDER. On a rate limit
# mid-run, agents/runner_utils.py rotates to the next _2/_3 key and retries (config.rotate_key()).
#
#   LLM_PROVIDER   groq | openrouter    (optional; auto-detected from which key is set)
#   LLM_MODEL      override the default model, e.g.:
#                  openrouter/nvidia/nemotron-3-super-120b-a12b:free   (verified free, tool-calling)
#                  openrouter/meta-llama/llama-3.3-70b-instruct        (paid; needs OpenRouter credit)
#                  groq/llama-3.3-70b-versatile
LLM_PROVIDER=
LLM_MODEL=

# Groq: free tier is 12k tokens/min AND 100k tokens/DAY per org — fine for small runs,
# too small for a full pass^k sweep (~4-6M tokens). See EVAL_REPORT.md §4.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# OpenRouter: one API over many providers. FREE (:free) models are capped at ~50 req/DAY
# per ACCOUNT (three keys on one account share it) and use congested upstream endpoints.
# ~$10 of credit lifts this to 1000 req/day AND unlocks reliable paid model endpoints.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

SEND_MODE=draft                          # "draft" = log only | "live" = real sending
AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.85
AUTO_RESOLVE_MAX_RISK_USD=10000.0

OPS_MANAGER_PHONE=+1xxxxxxxxxx
OPS_MANAGER_EMAIL=ops@yourcompany.com

# --- Phase 2+: GCP (leave blank until Phase 2) ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
FIRESTORE_DATABASE=(default)
GCS_BUCKET=

# --- Phase 3+: fine-tuning ---
HF_TOKEN=
DRAFTER_MODEL_ENDPOINT=gemini-2.0-flash
MIN_TRAIN_SCORE=80.0
MIN_SFT_SCORE=65.0
WEEKLY_FINE_TUNE_MIN_EXAMPLES=50

# --- Phase 4: voice ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
PUBLIC_BASE_URL=

# --- Comms (Phase 1: Slack optional, email stays in draft mode) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=resolv@yourdomain.com
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
